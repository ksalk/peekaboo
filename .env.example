# Copy this file to .env (gitignored) and adjust the values.
#   cp .env.example .env

# Host port for the web UI.
PEEKABOO_PORT=8080

# Image used by docker compose. Either build locally with
#   docker compose build
# or publish with mise and point this at your registry image.
PEEKABOO_IMAGE=peekaboo:local

# Initial administrator account. Only used while the users table is empty.
ADMIN_USERNAME=admin
# Required, 8-256 characters. docker compose refuses to start while this is empty.
ADMIN_PASSWORD=

# Optional global NVR credentials. Set both or leave both empty.
# Peekaboo uses them for every NVR. Never put credentials into the NVR addresses
# stored in the UI.
CAMERA_USERNAME=
CAMERA_PASSWORD=

# Limits and networking.
PEEKABOO_MAX_STREAMS=9
PEEKABOO_MAX_VIEWERS_PER_STREAM=8
PEEKABOO_RTSP_TRANSPORT=tcp

# Recording search uses the NVR's HTTP(S) ISAPI service. Leave the port empty to
# probe http://<NVR host> (port 80) and then https://<NVR host> (port 443).
# Set it only when the NVR web interface uses a custom HTTP port.
PEEKABOO_ISAPI_HTTP_PORT=
# Accept self-signed HTTPS certificates from NVRs. Only enable this on a trusted
# network; it disables certificate validation for NVR ISAPI requests.
PEEKABOO_ISAPI_INSECURE_TLS=false

# Set to true only when Peekaboo is exclusively reachable through a reverse proxy.
PEEKABOO_TRUST_PROXY=false
